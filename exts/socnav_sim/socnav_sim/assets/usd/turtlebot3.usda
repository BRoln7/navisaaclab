        def Xform "base_footprint" (
            apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding = </Root/turtlebot3_burger/Looks/material_black> (
                bindMaterialAs = "weakerThanDescendants"
            )
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            def PhysicsFixedJoint "base_joint"
            {
                rel physics:body0 = </Root/turtlebot3_burger/base_footprint>
                rel physics:body1 = </Root/turtlebot3_burger/base_link>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (0, 0, 0.01)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0, 1, 0, 0)
                quatf physics:localRot1 = (0, 1, 0, 0)
            }
        }

