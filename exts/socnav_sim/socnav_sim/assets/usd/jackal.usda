            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "X"
            rel physics:body0 = </Root/jackal/base_link>
            rel physics:body1 = </Root/jackal/rear_right_wheel_link>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            point3f physics:localPos0 = (-0.131, -0.187795, 0.0345)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
            float physxJoint:jointFriction = 0
            float physxJoint:maxJointVelocity = inf
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def Scope "PhysicsMaterials"
        {
            def Material "wheels" (
                apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.2
                float physics:staticFriction = 0.2
            }
        }
    }
}

